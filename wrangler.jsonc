{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "umbral-perimeter-os",
	"main": "worker/index.ts",
	"compatibility_date": "2025-05-01",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": [
			"/api/*"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "umbral-incidents-db",
			"database_id": "e09883b4-836f-4541-9acc-aab502a5d012",
			"migrations_dir": "migrations"
		}
	],
	"triggers": {
		"crons": [
			"* * * * *",
			"*/5 * * * *"
		]
	},
	"vars": {
		"ENVIRONMENT": "production",
		"RETENTION_DAYS": "90"
	}
}
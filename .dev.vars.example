# ==============================================================================
# Variables locales para `wrangler dev` (copia este archivo a `.dev.vars`)
# En producción configúralas con `pnpx wrangler secret put <NOMBRE>`
# ==============================================================================

ENVIRONMENT=development

# Acceso al dashboard:
DASHBOARD_ADMIN_EMAIL=tu-correo@ejemplo.com
DASHBOARD_API_KEY=dev-local-key-cambia-esto

# Verificación criptográfica de Cloudflare Access JWT (recomendado en producción):
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=

# Lista blanca privada de tus sitios (sobrescribe config/sites.config.ts sin subir dominios a GitHub):
# SITES_CONFIG_JSON=[{"id":"mi-web","name":"Mi Web","domain":"midominio.com","allowedHosts":["midominio.com","www.midominio.com"],"checkUrl":"https://midominio.com","cloudflareZoneId":"","vercelProjectId":""}]
SITES_CONFIG_JSON=

# Cloudflare API Token (permisos solo lectura: Zone -> Analytics:Read, Firewall Services:Read)
CLOUDFLARE_API_TOKEN=

# Vercel Personal Access Token (opcional, para detectar despliegues fallidos en Vercel Free)
VERCEL_API_TOKEN=

# Secretos HMAC exclusivos por cada sitio (debe coincidir con el `id` de cada sitio)
SITE_SECRETS_JSON={"mi-web-principal":"cambia-este-secreto-largo-1","mi-app":"cambia-este-secreto-largo-2"}

# Alertas en tiempo real (opcional - configura Telegram y/o Discord)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

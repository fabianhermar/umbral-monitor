{
  "name": "umbral-perimeter-os",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:worker": "wrangler dev --test-scheduled",
    "dev:demo": "wrangler dev --config wrangler.demo.jsonc",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "deploy": "vite build && wrangler deploy",
    "deploy:demo": "vite build && wrangler deploy --config wrangler.demo.jsonc",
    "db:migrate:local": "wrangler d1 migrations apply umbral-incidents-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply umbral-incidents-db --remote",
    "db:seed:local": "wrangler d1 execute umbral-incidents-db --local --file=./scripts/seed_local.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.13.23",
    "lucide-react": "^1.82.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.11.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261127.1",
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.4.0",
    "wrangler": "^4.168.0"
  }
}

{
  "name": "umbral-perimeter-os",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "vite",
    "dev:worker": "wrangler dev --test-scheduled",
    "build": "vite build",
    "typecheck": "tsc -p tsconfig.worker.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "deploy": "vite build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply umbral-incidents-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply umbral-incidents-db --remote",
    "db:seed:local": "wrangler d1 execute umbral-incidents-db --local --file=./scripts/seed_local.sql",
    "cf-typegen": "wrangler types"
  },
  "dependencies": {
    "hono": "^4.7.6",
    "lucide-react": "^0.511.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "recharts": "^2.15.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250520.0",
    "@tailwindcss/vite": "^4.1.7",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.7",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.16.1"
  }
}

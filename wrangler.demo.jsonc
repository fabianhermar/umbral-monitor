{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "umbral-demo",
  "main": "worker/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "vars": {
    "ENVIRONMENT": "production",
    "DEMO_MODE": "true"
  }
}
